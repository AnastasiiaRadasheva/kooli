@model Kool.Models.Registreerimine

@{
    ViewBag.Title = "Registreeru";
}

<h2>Registreeru</h2>

@using (Html.BeginForm("Create", "Registreerimines", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.Hidden("koolitusId", Model.KoolitusId)

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <p>Kas soovid registreeruda sellele koolitusele?</p>

    <button type="submit" class="btn btn-primary">Registreeru</button>
    @Html.ActionLink("Tagasi", "IndexK", "Koolitus", new { id = Model.KoolitusId }, null)
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}