@model Kool.Models.Registreerimine

@{
    ViewBag.Title = "Registreeru";
}

<h2>Registreeru</h2>

<div class="alert alert-info">
    Kas soovid registreeruda sellele koolitusele?
</div>

@using (Html.BeginForm("Create", "Registreerimines", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.Hidden("koolitusId", Model.KoolitusId)

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <button type="submit" class="btn btn-success">
        Registreeru
    </button>

    @Html.ActionLink("Tagasi", "IndexK", "Koolitus", null, new { @class = "btn btn-default" })
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}