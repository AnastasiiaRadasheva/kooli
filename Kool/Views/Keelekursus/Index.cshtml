@model IEnumerable<Kool.Models.Keelekursus>

@{
    ViewBag.Title = "Kursused";
    var grouped = Model.GroupBy(k => k.Keel);
}

<h2>Keelekursused</h2>

@if (User.IsInRole("Admin"))
{
    @Html.ActionLink("+ Lisa uus kursus", "Create", null, new { @class = "btn btn-success", style = "margin-bottom:20px;" })
}

@foreach (var group in grouped)
{
    var keel = group.Key.ToLower();
    var flag = "";

    if (keel.Contains("eesti")) { flag = "🇪🇪"; }
    else if (keel.Contains("inglise")) { flag = "🇬🇧"; }
    else if (keel.Contains("saksa")) { flag = "🇩🇪"; }

    <div class="panel panel-default" style="padding:20px; margin-bottom:25px;">

        <h3 style="margin-top:0;">@flag @group.Key</h3>

        <div class="row">

            @foreach (var item in group)
            {
                <div class="col-md-4">

                    <div style="
                        border:1px solid #ddd;
                        padding:20px;
                        text-align:center;
                        border-radius:8px;
                        margin-bottom:10px;
                        background:#f9f9f9;">

                        <h2 style="margin-top:0;">@item.Tase</h2>

                        <p class="small text-muted">
                            @item.Kirjeldus
                        </p>

                        @Html.ActionLink(
                            "Vaata koolitusi",
                            "ByKeelekursus",
                            "Koolitus",
                            new { id = item.Id },
                            new { @class = "btn btn-primary btn-sm" })

                        @if (User.IsInRole("Admin"))
                        {
                            <div style="margin-top:10px;">
                                @Html.ActionLink("Muuda", "Edit", new { id = item.Id }, new { @class = "btn btn-default btn-xs" })
                                @Html.ActionLink("Kustuta", "Delete", new { id = item.Id }, new { @class = "btn btn-danger btn-xs" })
                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    </div>
}