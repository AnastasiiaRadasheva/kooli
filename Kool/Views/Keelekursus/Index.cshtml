@model IEnumerable<Kool.Models.Keelekursus>

@{
    ViewBag.Title = "Kursused";
}

<div class="row" style="margin-top:20px;">
    <div class="col-md-6">
        <h2>Keelekursuste nimekiri</h2>
    </div>
   
</div>
<div class="col-md-6 text-right">
    @if (User.IsInRole("Admin"))
    {
        @Html.ActionLink("+ Lisa uus kursus", "Create", null, new { @class = "btn btn-success" })
    }
</div>
<table class="table table-hover">
    <thead>
        <tr class="active">
            <th>Kursuse nimetus</th>
            <th>Keel</th>
            <th>Tase</th>
            <th>Kirjeldus</th>
            <th class="text-right">Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="font-weight:bold; vertical-align:middle;">
                    @item.Nimetus
                </td>
                <td style="vertical-align:middle;">
                    @{
                        var keel = item.Keel.ToLower();
                        if (keel.Contains("eesti"))
                        { <span>🇪🇪</span> }
                        else if (keel.Contains("inglise"))
                        { <span>🇬🇧</span> }
                        else if (keel.Contains("saksa"))
                        { <span>🇩🇪</span> }
                        else if (keel.Contains("vene"))
                        { <span>🇷🇺</span> }
                        else if (keel.Contains("soome"))
                        { <span>🇫🇮</span> }
                        else if (keel.Contains("prantsuse"))
                        { <span>🇫🇷</span> }
                        else if (keel.Contains("hispaania"))
                        { <span>🇪🇸</span> }
                        else
                        { <span>🌐</span> }
                    }
                    @item.Keel
                </td>
                <td style="vertical-align:middle;">
                    @{
                        var silt = "label-default";
                        if (item.Tase.Contains("A")) { silt = "label-success"; }
                        else if (item.Tase.Contains("B")) { silt = "label-warning"; }
                        else if (item.Tase.Contains("C")) { silt = "label-danger"; }
                    }
                    <span class="label @silt" style="font-size: 0.9em; padding: 5px 10px;">@item.Tase</span>
                </td>
                <td class="small text-muted" style="vertical-align:middle;">
                    @item.Kirjeldus
                </td>
                <td class="text-right" style="vertical-align:middle;">
                    <div class="btn-group">
                        @Html.ActionLink("Vaata koolitusi", "ByKeelekursus", "Koolitus", new { id = item.Id }, new { @class = "btn btn-info btn-sm" })

                        @if (User.IsInRole("Admin"))
                        {
                            @Html.ActionLink("Muuda", "Edit", new { id = item.Id }, new { @class = "btn btn-default btn-sm" })
                            @Html.ActionLink("Kustuta", "Delete", new { id = item.Id }, new { @class = "btn btn-danger btn-sm" })
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>


