@model IEnumerable<Kool.Models.Registreerimine>

@{
    ViewBag.Title = "Kursuse osalejad";
}

<h2>Osalejad kursusel</h2>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}

<table class="table">
    <tr>
        <th>Kasutajanimi</th>
        <th>E-mail</th>
        <th>Staatus</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ApplicationUser.UserName</td>
            <td>@item.ApplicationUser.Email</td>
            <td><span class="label label-success">@item.Staatus</span></td>
            <td>
            </td>
        </tr>
    }
</table>

@if (User.IsInRole("Admin"))
{
    <div>
        @Html.ActionLink("Tagasi nimekirja", "IndexK", null, new { @class = "btn btn-default" })
    </div>
}
@if (User.IsInRole("Opetaja"))
{
    <div>
        @Html.ActionLink("Tagasi nimekirja", "MinuKoolitused", null, new { @class = "btn btn-default" })
    </div>
}
