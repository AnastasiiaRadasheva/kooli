@model List<Kool.Models.Registreerimine>

@{
    ViewBag.Title = "Registreerimised";
    int koolitusId = (int)ViewBag.KoolitusId;
}

<h2>Ootel registreerimised (Koolitus ID: @koolitusId)</h2>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-info">@TempData["Msg"]</div>
}

@if (!Model.Any())
{
    <p>Praegu ei ole ühtegi ootel registreerimist.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Kasutaja</th>
            <th>E-post</th>
            <th>Kuupäev</th>
            <th>Tegevused</th>
        </tr>

        @foreach (var r in Model)
        {
            <tr>
                <td>@(r.ApplicationUser?.UserName)</td>
                <td>@(r.ApplicationUser?.Email)</td>
                <td>@r.CreatedAt</td>
                <td>
                <td>
                <td>
                    @using (Html.BeginForm("Approve", "Registreerimines", new { id = r.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm">Kinnita</button>
                    }

                    @using (Html.BeginForm("Reject", "Registreerimines", new { id = r.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Keeldu</button>
                    }
                </td>
                </td>
                </td>
            </tr>
        }
    </table>
}

@Html.ActionLink("Tagasi", "IndexK", "Koolitus", null, null)