<h2>Saada kiri kogu grupile</h2>

@using (Html.BeginForm("SendGroupEmail", "Koolitus", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <input type="hidden" name="koolitusId" value="@ViewBag.KoolitusId" />

    <div class="form-group">
        <label>Teema</label>
        <input type="text" name="subject" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Sõnum</label>
        <textarea name="message" class="form-control" rows="5" required></textarea>
    </div>

    <br />

    <button type="submit" class="btn btn-success">
        Saada kõigile
    </button>
}