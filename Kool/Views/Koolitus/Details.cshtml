@model Kool.Models.Koolitus

@{
    ViewBag.Title = "Koolituse üksikasjad";
}

<div class="container" style="margin-top:30px;">

    <div class="panel panel-default" style="padding:25px; border-radius:10px;">

        <h2 style="margin-top:0;">
            @(Model.Keelekursus != null ? Model.Keelekursus.Nimetus : "Kursus")
        </h2>

        <p class="text-muted">
            @(Model.Keelekursus != null ? Model.Keelekursus.Kirjeldus : "")
        </p>

        <hr />

        <p>
            <strong>Keel:</strong>
            @(Model.Keelekursus != null ? Model.Keelekursus.Keel : "-")
        </p>

        <p>
            <strong>Tase:</strong>
            @(Model.Keelekursus != null ? Model.Keelekursus.Tase : "-")
        </p>

        <p>
            <strong>Õpetaja:</strong>
            @(Model.Opetaja != null ? Model.Opetaja.Nimi : "Määramata")
        </p>

        <p>
            <strong>Algus:</strong>
            @Model.AlgusKuupaev.ToString("dd.MM.yyyy")
        </p>

        <p>
            <strong>Lõpp:</strong>
            @Model.LoppKuupaev.ToString("dd.MM.yyyy")
        </p>

        <p>
            <strong>Hind:</strong>
            <span style="font-size:18px; color:#28a745;">
                @Model.Hind €
            </span>
        </p>

        <p>
            <strong>Max osalejaid:</strong>
            @Model.MaxOsalejaid
        </p>

    </div>

    <div style="margin-top:20px;">

        @if (User.IsInRole("Admin"))
        {
            @Html.ActionLink("Muuda", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
        }

        @Html.ActionLink("Tagasi", "IndexK", "Koolitus", null, new { @class = "btn btn-default" })

    </div>

</div>