@model IEnumerable<Kool.Models.Koolitus>

@{
    ViewBag.Title = "Koolitused";
    var pendingCounts = ViewBag.PendingCounts as Dictionary<int, int>;
    var approvedCounts = ViewBag.ApprovedCounts as Dictionary<int, int>;
}

<div class="row" style="margin-top:20px;">
    <div class="col-md-6">
        <h2>Koolituste nimekiri</h2>
    </div>
</div>
<div class="col-md-6 text-right">
    @if (User.IsInRole("Admin"))
    {
        @Html.ActionLink("+ Lisa uus koolitus", "Create", null, new { @class = "btn btn-success" })
    }
</div>
<div class="well">
    <form action="@Url.Action("Index1", "Koolitus")" method="get" class="form-inline">
        <input type="text" name="keel" class="form-control" placeholder="Otsi keelt..." value="@Request.QueryString["keel"]" />
        <input type="text" name="nimi" class="form-control" placeholder="Otsi õpetajat..." value="@Request.QueryString["nimi"]" />
        <button type="submit" class="btn btn-primary">Otsi</button>
        <a href="@Url.Action("Index1")" class="btn btn-default">Tühjenda</a>
    </form>
</div>
<table class="table table-hover">
    <thead>
        <tr class="active">
            <th>Kursus</th>
            <th>Õpetaja</th>
            <th>Algus</th>
            <th>Lõpp</th>
            <th>Hind</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Ootel soovid</th>
            }
            <th class="text-right">Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            int approved = 0;
            if (approvedCounts != null && approvedCounts.ContainsKey(item.Id))
            {
                approved = approvedCounts[item.Id];
            }
            int kinnitatud = 0;
            if (approvedCounts != null && approvedCounts.ContainsKey(item.Id))
            {
                kinnitatud = approvedCounts[item.Id];
            }

            int ootel = 0;
            if (pendingCounts != null && pendingCounts.ContainsKey(item.Id))
            {
                ootel = pendingCounts[item.Id];
            }

            bool onTais = kinnitatud >= item.MaxOsalejaid;

            <tr>
                <td style="font-weight:bold; vertical-align:middle;">
                    @(item.Keelekursus != null ? item.Keelekursus.Nimetus : "Kursus puudub")
                </td>
                <td style="vertical-align:middle;">
                    @(item.Opetaja != null ? item.Opetaja.Nimi : "Määramata")
                </td>
                <td style="vertical-align:middle;">
                    @item.AlgusKuupaev.ToString("dd.MM.yyyy")
                </td>
                <td style="vertical-align:middle;">
                    @item.LoppKuupaev.ToString("dd.MM.yyyy")
                </td>
                <td style="vertical-align:middle;">
                    <strong>@item.Hind €</strong>
                </td>

                @if (User.IsInRole("Admin"))
                {
                    <td style="vertical-align:middle;">
                        @if (ootel > 0)
                        {
                            <a href="@Url.Action("Registrations", "Koolitus", new { id = item.Id })" class="label label-warning" style="padding: 5px 8px; font-size: 0.9em;">
                                @ootel uut registreerimist
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small">0 ootel soovi</span>
                        }
                    </td>
                }

                <td class="text-right" style="vertical-align:middle;">
                    <div class="btn-group">
                        @if (onTais)
                        {
                            <span class="label label-danger" style="margin-right:10px; display:inline-block; padding: 6px;">Grupp on täis</span>
                        }
                        else if (Request.IsAuthenticated && User.IsInRole("Opilane"))
                        {
                            @Html.ActionLink("Registreeru", "Create", "Registreerimines", new { koolitusId = item.Id }, new { @class = "btn btn-primary btn-sm" })
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            @Html.ActionLink("Vaata (" + approved + ")", "Osalejad", "Koolitus",
                                new { id = item.Id },
                                new { @class = "btn btn-info btn-sm" })

                            @Html.ActionLink("Muuda", "Edit", new { id = item.Id }, new { @class = "btn btn-warning btn-sm" })
                            @Html.ActionLink("Kustuta", "Delete", new { id = item.Id }, new { @class = "btn btn-danger btn-sm" })
                        }
                    </div>
                        </td>
                    </tr>
        }
    </tbody>
</table>