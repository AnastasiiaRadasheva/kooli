@model IEnumerable<Kool.Models.Koolitus>

@{
    ViewBag.Title = "Koolitused";
    var pendingCounts = ViewBag.PendingCounts as Dictionary<int, int>;
    var approvedCounts = ViewBag.ApprovedCounts as Dictionary<int, int>;
}

<div class="row" style="margin-top:20px;">
    <div class="col-md-6">
        <h2>Koolituste nimekiri</h2>
    </div>
</div>

<div class="col-md-6 text-right">
    @if (User.IsInRole("Admin"))
    {
        @Html.ActionLink("+ Lisa uus koolitus", "Create", null, new { @class = "btn btn-success" })
    }
</div>

<div class="well">
    <form action="@Url.Action("IndexK", "Koolitus")" method="get" class="form-inline">
        <input type="text" name="keel" class="form-control" placeholder="Otsi keelt..." value="@Request.QueryString["keel"]" />
        <input type="text" name="nimi" class="form-control" placeholder="Otsi õpetajat..." value="@Request.QueryString["nimi"]" />
        <button type="submit" class="btn btn-primary">Otsi</button>
        <a href="@Url.Action("IndexK")" class="btn btn-default">Tühjenda</a>
    </form>
</div>

<table class="table table-hover">
    <div class="row">

        @foreach (var item in Model)
        {
            int approved = 0;
            if (approvedCounts != null && approvedCounts.ContainsKey(item.Id))
            {
                approved = approvedCounts[item.Id];
            }

            int ootel = 0;
            if (pendingCounts != null && pendingCounts.ContainsKey(item.Id))
            {
                ootel = pendingCounts[item.Id];
            }

            bool onTais = approved >= item.MaxOsalejaid;


            <div class="col-md-4" style="margin-bottom:25px;">
                <div class="card shadow-sm" style="padding:20px; border-radius:10px; height:100%;">

                   <h3 style="margin-top:0;">

                       @if (item.Keelekursus != null)
                       {
                           if (item.Keelekursus.Keel.Contains("Eesti"))
                           {
                               <img src="~/Content/flags/ee.png" width="24" style="margin-right:6px;" />
                           }
                           else if (item.Keelekursus.Keel.Contains("Inglise"))
                           {
                               <img src="~/Content/flags/gb.png" width="24" style="margin-right:6px;" />
                           }
                           else if (item.Keelekursus.Keel.Contains("Saksa"))
                           {
                               <img src="~/Content/flags/de.png" width="24" style="margin-right:6px;" />
                           }
                       }

                       @(item.Keelekursus != null ? item.Keelekursus.Nimetus : "Kursus puudub")

                   </h3>

                    <p>
                        <strong>Õpetaja:</strong>
                        @(item.Opetaja != null ? item.Opetaja.Nimi : "Määramata")
                    </p>

                    <p>
                        <strong>Algus:</strong>
                        @item.AlgusKuupaev.ToString("dd.MM.yyyy")
                    </p>

                    <p>
                        <strong>Lõpp:</strong>
                        @item.LoppKuupaev.ToString("dd.MM.yyyy")
                    </p>

                    <p>
                        <strong>Hind:</strong>
                        <span style="font-size:18px; color:#28a745;">
                            @item.Hind €
                        </span>
                    </p>

                    @if (User.IsInRole("Admin"))
                    {
                        <p>
                            <strong>Ootel:</strong>

                            @if (ootel > 0)
                            {
                                <a href="@Url.Action("Registrations", "Koolitus", new { id = item.Id })" class="label label-warning">
                                    @ootel uut soovi
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">0</span>
                            }
                        </p>
                    }

                    <div style="margin-top:15px;">

                        @if (onTais)
                        {
                            <span class="label label-danger" style="display:block; margin-bottom:10px;">
                                GRUPP TÄIS
                            </span>
                        }

                        @if (Request.IsAuthenticated && User.IsInRole("Opilane"))
                        {
                            if (!onTais)
                            {
                                @Html.ActionLink("Registreeru", "Create", "Registreerimines",
                                    new { koolitusId = item.Id },
                                    new { @class = "btn btn-primary btn-sm" })
                            }
                        }

                        @if (!Request.IsAuthenticated)
                        {
                            if (!onTais)
                            {
                                @Html.ActionLink("Registreeru", "Login", "Account",
                                    new { koolitusId = item.Id },
                                    new { @class = "btn btn-primary btn-sm" })
                            }
                        }

                        @Html.ActionLink("Detailid", "Details",
                            new { id = item.Id },
                            new { @class = "btn btn-default btn-sm" })

                        @if (User.IsInRole("Admin"))
                        {
                            @Html.ActionLink("Vaata (" + approved + ")", "Osalejad", "Koolitus",
                                new { id = item.Id },
                                new { @class = "btn btn-info btn-sm" })

                            @Html.ActionLink("Muuda", "Edit",
                                new { id = item.Id },
                                new { @class = "btn btn-warning btn-sm" })

                            @Html.ActionLink("Kustuta", "Delete",
                                new { id = item.Id },
                                new { @class = "btn btn-danger btn-sm" })
                        }

                    </div>

                </div>
            </div>
        }

    </div>
</table>