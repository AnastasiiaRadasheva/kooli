@model IEnumerable<Kool.Models.Koolitus>

@{
    ViewBag.Title = "Minu koolitused";

    bool isOpetaja = User.IsInRole("Opetaja");
    bool isOpilane = User.IsInRole("Opilane");

    var myStatuses = ViewBag.MyStatuses as Dictionary<int, Kool.Models.RegistreerimineStaatus>;
    var approvedCounts = ViewBag.ApprovedCounts as Dictionary<int, int>;
}

<h2>Minu koolitused</h2>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-info">@TempData["Msg"]</div>
}

@if (!Model.Any())
{
    <p>Sul ei ole veel oma koolitusi.</p>
}
else
{
    <table class="table table-striped">
        <tr>
            <th>Kursus</th>
            <th>Keel / Tase</th>
            <th>Algus</th>
            <th>Lõpp</th>
            <th>Hind</th>
            <th>Max osalejaid</th>

            @if (isOpetaja)
            {
                <th>Osalejad</th>
            }

            @if (isOpilane)
            {
                <th>Staatus</th>
            }

            <th>Tegevused</th>
        </tr>

        @foreach (var k in Model)
        {
            int approved = 0;
            if (approvedCounts != null && approvedCounts.ContainsKey(k.Id))
            {
                approved = approvedCounts[k.Id];
            }

            Kool.Models.RegistreerimineStaatus? staatus = null;
            if (myStatuses != null && myStatuses.ContainsKey(k.Id))
            {
                staatus = myStatuses[k.Id];
            }

            <tr>
                <td>@(k.Keelekursus?.Nimetus ?? ("Koolitus #" + k.Id))</td>
                <td>@(k.Keelekursus != null ? (k.Keelekursus.Keel + " / " + k.Keelekursus.Tase) : "")</td>
                <td>@k.AlgusKuupaev.ToString("dd.MM.yyyy")</td>
                <td>@k.LoppKuupaev.ToString("dd.MM.yyyy")</td>
                <td>@k.Hind €</td>
                <td>@k.MaxOsalejaid</td>

                @if (isOpetaja)
                {
                    <td>
                        @Html.ActionLink("Vaata (" + approved + ")", "Osalejad", "Koolitus", new { id = k.Id }, new { @class = "btn btn-sm btn-info" })
                    </td>
                }

                @if (isOpilane)
                {
                    <td>
                        @if (staatus.HasValue)
                        {
                            <span class="label label-default">@staatus.Value.ToString()</span>
                        }
                    </td>
                }

                <td>
                    <div class="btn-group">
                        @Html.ActionLink("Details", "Details", "Koolitus", new { id = k.Id }, new { @class = "btn btn-sm btn-default" })

                        @if (isOpetaja && approved > 0)
                        {
                            <button type="button" class="btn btn-sm btn-warning" data-toggle="modal" data-target="#mailModal-@k.Id">
                                <i class="glyphicon glyphicon-envelope"></i> Saada teade
                            </button>
                        }
                    </div>

                    @if (isOpetaja && approved > 0)
                    {
                        <div class="modal fade" id="mailModal-@k.Id" tabindex="-1" role="dialog">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    @using (Html.BeginForm("SendGroupEmail", "Koolitus", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="koolitusId" value="@k.Id" />

                                        <div class="modal-header">
                                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                                            <h4 class="modal-title">Teade grupile: @k.Keelekursus.Nimetus</h4>
                                        </div>
                                        <div class="modal-body">
                                            <div class="form-group">
                                                <label>Teema:</label>
                                                <input type="text" name="subject" class="form-control" value="Teade kursuse kohta" required />
                                            </div>
                                            <div class="form-group">
                                                <label>Sõnum:</label>
                                                <textarea name="message" class="form-control" rows="5" placeholder="Kirjutage teade siia..." required></textarea>
                                            </div>
                                            <p class="small text-muted">Kiri saadetakse @approved õpilasele.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-default" data-dismiss="modal">Tühista</button>
                                            <button type="submit" class="btn btn-primary">Saada postitus</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </td>
            </tr>
        }
    </table>
}Razor CSHTML
@section scripts {
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
}