@model IEnumerable<Kool.Models.Opetaja>

@{
    ViewBag.Title = "Õpetajad";
}

<h2>Õpetajad</h2>
@if (User.IsInRole("Admin"))
{
    <p>
        @Html.ActionLink("Lisa uus", "Create")
    </p>
}

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4" style="margin-bottom:25px;">
                <div class="card shadow-sm" style="padding:20px; border-radius:10px; text-align:center; height:100%;">

                    <img src="@Url.Content("~/Content/uploads/opetajad/" +
(string.IsNullOrEmpty(item.FotoPath) ? "default.png" : item.FotoPath))"
                         alt="@item.Nimi"
                         style="width:140px;height:140px;object-fit:cover;display:block;margin:0 auto 15px;" />
                    <h3 style="margin-top:0;">
                        @Html.DisplayFor(modelItem => item.Nimi)
                    </h3>

                    <p style="color:#666;">
                        @Html.DisplayFor(modelItem => item.Kvalifikatsioon)
                    </p>

                    <div style="margin-top:15px;">

                        @Html.ActionLink(
                            "Koolitused",
                            "ByOpetaja1",
                            "Koolitus",
                            new { id = item.Id },
                            new { @class = "btn btn-info btn-sm" }
                        )

                        @if (User.IsInRole("Admin"))
                        {
                            @Html.ActionLink(
                                "Muuda",
                                "Edit",
                                new { id = item.Id },
                                new { @class = "btn btn-warning btn-sm" }
                            )

                            @Html.ActionLink(
                                "Kustuta",
                                "Delete",
                                new { id = item.Id },
                                new { @class = "btn btn-danger btn-sm" }
                            )
                        }

                    </div>

                </div>
            </div>
        }

    </div>
