@{
    ViewBag.Title = "E-posti kinnitamine";
}
<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title.</h2>
    <div>
        <p>
            Täname e-posti aadressi kinnitamise eest. Palun
            @Html.ActionLink(
                "klõpsa siia sisselogimiseks",
                "Login",
                "Account",
                routeValues: null,
                htmlAttributes: new { id = "loginLink" }
            )
        </p>
    </div>
</main>